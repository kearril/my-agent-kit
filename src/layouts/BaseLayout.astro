---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
interface Props {
	title: string;
	description: string;
	canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/kearril-seal-master.png" />
		<link rel="apple-touch-icon" href="/kearril-seal-master.png" />
		<title>{title}</title>
		{canonicalPath ? <link rel="canonical" href={Astro.site ? new URL(canonicalPath, Astro.site).href : canonicalPath} /> : null}
	</head>
	<body>
		<slot />
	</body>
</html>
