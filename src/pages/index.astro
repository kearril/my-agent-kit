---
import AboutSection from '../components/home/AboutSection.astro';
import ExploreSection from '../components/home/ExploreSection.astro';
import FeaturedSection from '../components/home/FeaturedSection.astro';
import Hero from '../components/home/Hero.astro';
import NotesSection from '../components/home/NotesSection.astro';
import UpdatesSection from '../components/home/UpdatesSection.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomepageEntries, getPublicEntries } from '../lib/entries';
import { createExploreIndex } from '../lib/explore-index';

const { featured, recent, notes } = await getHomepageEntries();
const explore = createExploreIndex(await getPublicEntries());
---

<BaseLayout title="Paracosm Garden" description="Paracosm Garden 是一个公开生长的个人数字花园。" canonicalPath="/">
	<SiteHeader />
	<main id="top">
		<Hero />
		<div class="washi-section-divider" aria-hidden="true" />
		<AboutSection />
		<div class="washi-section-divider" aria-hidden="true" />
		<FeaturedSection entries={featured} />
		<div class="washi-section-divider" aria-hidden="true" />
		<UpdatesSection entries={recent} />
		<div class="washi-section-divider" aria-hidden="true" />
		<NotesSection entries={notes} />
		<div class="washi-section-divider" aria-hidden="true" />
		<ExploreSection entries={explore} />
	</main>
	<SiteFooter />
</BaseLayout>
