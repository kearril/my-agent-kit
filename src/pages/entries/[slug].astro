---
import { render } from 'astro:content';
import { ArrowLeft, Calendar, Clock, Tag, ExternalLink, Layers, Link as LinkIcon, Sparkles, Wrench, Compass, FolderGit2, StickyNote } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import { getEntryConnections, getPublicEntries, getPublicEntry } from '../../lib/entries';
import { getEntryPath } from '../../lib/entry-path';

export async function getStaticPaths() {
	return (await getPublicEntries()).map((entry) => ({ params: { slug: entry.id } }));
}

const entry = await getPublicEntry(Astro.params.slug ?? '');
if (!entry) throw new Error(`Could not find public entry "${Astro.params.slug}".`);
const { Content } = await render(entry);
const { related, backlinks } = await getEntryConnections(entry.id);

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('zh-CN', {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	}).format(date);

---

<BaseLayout
	title={`${entry.data.title} | Paracosm Garden`}
	description={entry.data.summary}
	canonicalPath={getEntryPath(entry)}
>
	<SiteHeader article />

	<main class="article-shell">
		<div class="article-breadcrumb-bar">
			<a class="article-breadcrumb-btn" href="/" data-history-back>
				<ArrowLeft size={16} stroke-width={2.5} />
				<span>返回上一页</span>
			</a>
			<span class="article-specimen-id">SPECIMEN // {entry.id}</span>
		</div>
		<article class="article-content">
			<!-- Article Header -->
			<header class="article-header">
				<div class="article-badges-row">
					<span class:list={['mini-badge', `mini-badge--${entry.data.type}`]}>
						{entry.data.type.toUpperCase()}
					</span>
					{entry.data.type === 'note' && entry.data.category && (
						<span class="article-category-badge">
							VOL // {entry.data.category}
						</span>
					)}
					<div class="article-status-stamp" aria-hidden="true">
						[ VERIFIED SPECIMEN ]
					</div>
				</div>

				<h1 class="article-main-title">{entry.data.title}</h1>

				{entry.data.summary && (
					<div class="article-summary-box">
						<p class="article-summary-text">{entry.data.summary}</p>
					</div>
				)}

				<div class="article-meta-deck">
					<div class="article-meta-dates">
						{entry.data.publishedAt && (
							<div class="article-meta-item">
								<Calendar size={14} stroke-width={2.5} />
								<span class="meta-label">首次收录:</span>
								<time datetime={entry.data.publishedAt.toISOString()}>
									{formatDate(entry.data.publishedAt)}
								</time>
							</div>
						)}
						<div class="article-meta-item">
							<Clock size={14} stroke-width={2.5} />
							<span class="meta-label">最近修订:</span>
							<time datetime={entry.data.updatedAt.toISOString()}>
								{formatDate(entry.data.updatedAt)}
							</time>
						</div>
					</div>

					{entry.data.tags && entry.data.tags.length > 0 && (
						<div class="article-tags-group">
							{entry.data.tags.map((tag) => (
								<span class="article-tag-chip">
									<Tag size={11} stroke-width={2.5} style="display: inline; vertical-align: -1px; margin-right: 2px;" />
									#{tag}
								</span>
							))}
						</div>
					)}
				</div>
			</header>

			<!-- Prose Body -->
			<div class="prose">
				<Content />
			</div>

			<!-- External Links Section -->
			{entry.data.links && entry.data.links.length > 0 && (
				<section class="article-section" aria-labelledby="external-links-title">
					<div class="article-section-header">
						<span class="section-header-dot" aria-hidden="true" />
						<h2 id="external-links-title">外部资源与关联链接</h2>
					</div>
					<ul class="article-link-list">
						{entry.data.links.map((link) => (
							<li>
								<a href={link.url} target="_blank" rel="noopener noreferrer">
									<span style="display: inline-flex; align-items: center; gap: 8px;">
										<LinkIcon size={16} stroke-width={2.5} />
										{link.label}
									</span>
									<ExternalLink size={16} stroke-width={2.5} class="article-external-arrow" />
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
			<!-- Bi-directional Graph Connections -->
			{related.length > 0 && (
				<section class="article-section" aria-labelledby="related-entries-title">
					<div class="article-section-header">
						<span class="section-header-dot" aria-hidden="true" />
						<h2 id="related-entries-title">双向关联条目 (Related)</h2>
					</div>
					<ul class="article-connection-list">
						{related.map((item) => (
							<li>
								<a href={getEntryPath(item)}>
									<div class="article-connection-header">
										<span class:list={['mini-badge', `mini-badge--${item.data.type}`]}>
											{item.data.type.toUpperCase()}
										</span>
										<strong>{item.data.title}</strong>
									</div>
									<p>{item.data.summary}</p>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			<!-- Backlinks Section -->
			{backlinks.length > 0 && (
				<section class="article-section" aria-labelledby="backlinks-title">
					<div class="article-section-header">
						<span class="section-header-dot" aria-hidden="true" />
						<h2 id="backlinks-title">反向引用 (Backlinks)</h2>
					</div>
					<ul class="article-connection-list">
						{backlinks.map((item) => (
							<li>
								<a href={getEntryPath(item)}>
									<div class="article-connection-header">
										<span class:list={['mini-badge', `mini-badge--${item.data.type}`]}>
											{item.data.type.toUpperCase()}
										</span>
										<strong>{item.data.title}</strong>
									</div>
									<p>{item.data.summary}</p>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
		</article>
	</main>

	<SiteFooter />

	<!-- Code Block Copy Button Script -->
	<script is:inline>
		function initCodeCopyButtons() {
			document.querySelectorAll('.prose pre').forEach((preBlock) => {
				if (preBlock.closest('.code-block-wrapper')) return;
				const wrapper = document.createElement('div');
				wrapper.className = 'code-block-wrapper';
				preBlock.parentNode?.insertBefore(wrapper, preBlock);
				wrapper.appendChild(preBlock);

				const copyBtn = document.createElement('button');
				copyBtn.className = 'code-copy-btn';
				copyBtn.type = 'button';
				copyBtn.setAttribute('aria-label', '复制代码内容');
				copyBtn.innerHTML =
					'<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="0"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>复制</span>';

				copyBtn.addEventListener('click', async (e) => {
					e.preventDefault();
					const codeEl = preBlock.querySelector('code');
					const text = (codeEl ? codeEl.innerText : preBlock.innerText).trim();
					try {
						await navigator.clipboard.writeText(text);
						copyBtn.setAttribute('aria-label', '代码已复制');
						copyBtn.innerHTML =
							'<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12 4 4L19 6"></path></svg><span>已复制!</span>';
						copyBtn.classList.add('code-copy-btn--copied');
						setTimeout(() => {
							copyBtn.innerHTML =
								'<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="0"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>复制</span>';
							copyBtn.setAttribute('aria-label', '复制代码内容');
							copyBtn.classList.remove('code-copy-btn--copied');
						}, 2000);
					} catch (err) {
						console.error('Copy failed:', err);
					}
				});
				wrapper.appendChild(copyBtn);
			});
		}

		document.querySelector('[data-history-back]')?.addEventListener('click', (event) => {
			if (window.history.length > 1) {
				event.preventDefault();
				window.history.back();
			}
		});

		initCodeCopyButtons();
		document.addEventListener('astro:page-load', initCodeCopyButtons);
	</script>
</BaseLayout>
