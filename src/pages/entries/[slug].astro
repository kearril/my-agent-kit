---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import { getEntryConnections, getPublicEntries, getPublicEntry } from '../../lib/entries';
import { getEntryPath } from '../../lib/entry-path';

export async function getStaticPaths() {
	return (await getPublicEntries()).map((entry) => ({ params: { slug: entry.id } }));
}

const entry = await getPublicEntry(Astro.params.slug ?? '');
if (!entry) throw new Error(`Could not find public entry "${Astro.params.slug}".`);
const { Content } = await render(entry);
const { related, backlinks } = await getEntryConnections(entry.id);

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('zh-CN', {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	}).format(date);
---

<BaseLayout
	title={`${entry.data.title} | Paracosm Garden`}
	description={entry.data.summary}
	canonicalPath={getEntryPath(entry)}
>
	<SiteHeader article />
	<main class="article-shell">
		<article class="article-content">
			<div class="article-header">
				<div class="article-badges">
					<span class:list={['mini-badge', `mini-badge--${entry.data.type}`]}>{entry.data.type}</span>
					{entry.data.type === 'note' && entry.data.category && (
						<span class="eyebrow eyebrow--coral">{entry.data.category}</span>
					)}
				</div>
				<h1>{entry.data.title}</h1>
				<p class="article-summary">{entry.data.summary}</p>
				<div class="article-meta">
					{entry.data.publishedAt && (
						<div class="article-meta-item">
							<span class="article-meta-label">首次公开</span>
							<time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt)}</time>
						</div>
					)}
					<div class="article-meta-item">
						<span class="article-meta-label">最近更新</span>
						<time datetime={entry.data.updatedAt.toISOString()}>{formatDate(entry.data.updatedAt)}</time>
					</div>
				</div>
			</div>

			<div class="prose">
				<Content />
			</div>

			{entry.data.links && entry.data.links.length > 0 && (
				<section class="article-section" aria-labelledby="external-links-title">
					<h2 id="external-links-title">外部链接</h2>
					<ul class="article-link-list">
						{entry.data.links.map((link) => (
							<li>
								<a href={link.url} target="_blank" rel="noopener noreferrer">
									<span>{link.label}</span>
									<span class="article-external-arrow" aria-hidden="true">↗</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{related.length > 0 && (
				<section class="article-section" aria-labelledby="related-entries-title">
					<h2 id="related-entries-title">关联条目</h2>
					<ul class="article-connection-list">
						{related.map((item) => (
							<li>
								<a href={getEntryPath(item)}>
									<div class="article-connection-header">
										<span class:list={['mini-badge', `mini-badge--${item.data.type}`]}>{item.data.type}</span>
										<strong>{item.data.title}</strong>
									</div>
									{item.data.summary && <p>{item.data.summary}</p>}
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{backlinks.length > 0 && (
				<section class="article-section" aria-labelledby="backlinks-title">
					<h2 id="backlinks-title">反向链接</h2>
					<ul class="article-connection-list">
						{backlinks.map((item) => (
							<li>
								<a href={getEntryPath(item)}>
									<div class="article-connection-header">
										<span class:list={['mini-badge', `mini-badge--${item.data.type}`]}>{item.data.type}</span>
										<strong>{item.data.title}</strong>
									</div>
									{item.data.summary && <p>{item.data.summary}</p>}
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
		</article>
	</main>
</BaseLayout>
