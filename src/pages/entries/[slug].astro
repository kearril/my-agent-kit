---
import { render } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import EntryMetadataPanel from '../../components/article/EntryMetadataPanel.astro';
import { getEntryConnections, getPublicEntries, getPublicEntry } from '../../lib/entries';
import { getEntryPath } from '../../lib/entry-path';

export async function getStaticPaths() {
	return (await getPublicEntries()).map((entry) => ({ params: { slug: entry.id } }));
}

const entry = await getPublicEntry(Astro.params.slug ?? '');
if (!entry) throw new Error(`Could not find public entry "${Astro.params.slug}".`);
const { Content } = await render(entry);
const { related, backlinks } = await getEntryConnections(entry.id);
---

<BaseLayout
	title={`${entry.data.title} | Paracosm Garden`}
	description={entry.data.summary}
	canonicalPath={getEntryPath(entry)}
>
	<SiteHeader article />

	<main class="article-shell">
		<div class="article-breadcrumb-bar">
			<a class="article-breadcrumb-btn" href="/" data-history-back>
				<ArrowLeft size={16} stroke-width={2.5} />
				<span>返回上一页</span>
			</a>
			<span class="article-specimen-id">SPECIMEN // {entry.id}</span>
		</div>

		<div class="article-workbench-grid">
			<!-- Left Wing: Standalone Metadata Dossier Panel -->
			<div class="article-left-wing">
				<EntryMetadataPanel entry={entry} related={related} backlinks={backlinks} />
			</div>

			<!-- Main Track: Centered Pure Reading Binder -->
			<div class="article-main-track">
				<article class="article-content">
					<!-- Pure Article Header -->
					<header class="article-header">
						<h1 class="article-main-title">{entry.data.title}</h1>

						{entry.data.summary && (
							<div class="article-summary-box">
								<p class="article-summary-text">{entry.data.summary}</p>
							</div>
						)}
					</header>

					<!-- Pure Prose Body -->
					<div class="prose">
						<Content />
					</div>
				</article>
			</div>

			<!-- Right Wing Spacer for Symmetry -->
			<div class="article-right-wing-spacer" aria-hidden="true" />
		</div>
	</main>

	<SiteFooter />

	<!-- Code Block Copy Button Script -->
	<script is:inline>
		function initCodeCopyButtons() {
			document.querySelectorAll('.prose pre').forEach((preBlock) => {
				if (preBlock.closest('.code-block-wrapper')) return;
				const wrapper = document.createElement('div');
				wrapper.className = 'code-block-wrapper';
				preBlock.parentNode?.insertBefore(wrapper, preBlock);
				wrapper.appendChild(preBlock);

				const copyBtn = document.createElement('button');
				copyBtn.className = 'code-copy-btn';
				copyBtn.type = 'button';
				copyBtn.setAttribute('aria-label', '复制代码内容');
				copyBtn.innerHTML =
					'<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="0"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>复制</span>';

				copyBtn.addEventListener('click', async (e) => {
					e.preventDefault();
					const codeEl = preBlock.querySelector('code');
					const text = (codeEl ? codeEl.innerText : preBlock.innerText).trim();
					try {
						await navigator.clipboard.writeText(text);
						copyBtn.setAttribute('aria-label', '代码已复制');
						copyBtn.innerHTML =
							'<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12 4 4L19 6"></path></svg><span>已复制!</span>';
						copyBtn.classList.add('code-copy-btn--copied');
						setTimeout(() => {
							copyBtn.innerHTML =
								'<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="0"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>复制</span>';
							copyBtn.setAttribute('aria-label', '复制代码内容');
							copyBtn.classList.remove('code-copy-btn--copied');
						}, 2000);
					} catch (err) {
						console.error('Copy failed:', err);
					}
				});
				wrapper.appendChild(copyBtn);
			});
		}

		document.querySelector('[data-history-back]')?.addEventListener('click', (event) => {
			if (window.history.length > 1) {
				event.preventDefault();
				window.history.back();
			}
		});

		initCodeCopyButtons();
		document.addEventListener('astro:page-load', initCodeCopyButtons);
	</script>
</BaseLayout>
