---
import { getEntryPath } from '../../lib/entry-path';
import type { NoteEntry } from '../../lib/entries';
import { Tag } from '@lucide/astro';

interface Props {
	entries: NoteEntry[];
}

const { entries } = Astro.props;

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('zh-CN', {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	}).format(date);

// Group entries by category
const categoryMap = new Map<string, NoteEntry[]>();
for (const entry of entries) {
	const cat = entry.data.category || '综合随笔';
	const list = categoryMap.get(cat) ?? [];
	list.push(entry);
	categoryMap.set(cat, list);
}

const volumes = Array.from(categoryMap.entries()).map(([category, items], index) => ({
	volNumber: String(index + 1).padStart(2, '0'),
	category,
	items,
}));
---

<section id="notes" class="notes-section" aria-labelledby="notes-title">
	<div class="notes-heading-row">
		<div class="notes-heading-left">
			<div class="eyebrow eyebrow--tape">
				<span>SECTION 05 // FIELD JOURNAL</span>
			</div>
			<h2 id="notes-title" class="notes-title">
				<span class="notes-title-en">FIELD NOTES</span>
				<span class="notes-title-cn">· 思考随笔</span>
			</h2>
		</div>
		<div class="notes-heading-right">
			<p class="notes-heading-desc">
				技术探索、架构复盘与非线性的数字随笔。按专业维度归卷成册，支持独立长文页面与深度阅读。
			</p>
			<div class="notes-volume-seal" aria-hidden="true">
				<span class="volume-seal-label">ESSAYS // ARCHIVE</span>
				<span class="volume-seal-count">{entries.length} POSTS</span>
			</div>
		</div>
	</div>

	{entries.length > 0 ? (
		<div class="notes-volumes-container">
			{volumes.map((vol) => (
				<div class="notes-volume-group">
					<!-- Volume Header Bar -->
					<div class="volume-header-bar">
						<div class="volume-title-group">
							<span class="volume-tag">VOL {vol.volNumber}</span>
							<h3 class="volume-name">{vol.category}</h3>
						</div>
						<div class="volume-rule-line" aria-hidden="true" />
						<span class="volume-count-pill">{vol.items.length} 篇收录</span>
					</div>

					<!-- Stacked Accordion Deck of Notes -->
					<div class="notes-stacked-deck">
						{vol.items.map((entry) => {
							const dateStr = formatDate(entry.data.createdAt || entry.data.updatedAt);
							return (
								<article class="note-stacked-card">
									<a
										class="note-card-main-link"
										href={getEntryPath(entry)}
										aria-label={`阅读长文：${entry.data.title}`}
									>
										<!-- Collapsed Bar (Always Visible) -->
										<div class="note-card-top-bar">
											<div class="note-card-top-left">
												<time
													datetime={(entry.data.createdAt || entry.data.updatedAt).toISOString()}
													class="note-card-date"
												>
													{dateStr}
												</time>
												<span class="mini-badge mini-badge--note">
													{entry.data.category || 'NOTE'}
												</span>
												<h4 class="note-card-title">{entry.data.title}</h4>
											</div>
											<div class="note-card-top-right">
												<span class="note-expand-hint">展开导读</span>
											</div>
										</div>

										<!-- Expanded Drawer (Smooth CSS Transition Reveal) -->
										<div class="note-card-expanded-body">
											<div class="note-card-divider" />
											<div class="note-card-body-content">
												<p class="note-card-summary">{entry.data.summary}</p>
												<div class="note-card-footer-row">
													{entry.data.tags && entry.data.tags.length > 0 && (
														<div class="note-tag-list">
															{entry.data.tags.map((tag) => (
																<span class="note-tag-pill">
																	<Tag size={10} stroke-width={2.5} style="display: inline; vertical-align: -1px; margin-right: 3px;" />
																	<span>{tag}</span>
																</span>
															))}
														</div>
													)}
													<div class="note-card-action-box">
														<span class="note-read-btn">阅读长文完整篇章</span>
													</div>
												</div>
											</div>
										</div>
									</a>
								</article>
							);
						})}
					</div>
				</div>
			))}
		</div>
	) : (
		<div class="notes-empty-state">
			<div class="empty-notes-badge">[ JOURNAL EMPTY // 暂无文章 ]</div>
			<p class="empty-notes-text">第一篇深度思考随笔正在撰写中，敬请期待。</p>
		</div>
	)}

	<div class="notes-bottom-tape" aria-hidden="true" />
</section>
