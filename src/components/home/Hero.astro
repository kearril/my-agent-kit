---
import { ArrowDownRight } from '@lucide/astro';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero-copy">
		<div class="tape-eyebrow">
			<span class="washi-tape-strip" aria-hidden="true"></span>
			<span class="eyebrow-text">DIGITAL GARDEN · 想法与工具的生长地</span>
		</div>
		<h1 id="hero-title">
			<span class="hero-title-black">
				I GROW
				<span class="stamp stamp--cultivating" aria-hidden="true">SEEDS & ARTIFACTS</span>
			</span>
			<span class="hero-title-white">WHAT FASCINATES ME.</span>
		</h1>
		<div class="postit-note">
			<span class="postit-pin" aria-hidden="true"></span>
			<p class="hero-desc">
				这里是我的个人数字花园。持续培育和记录所有令我为之驻足的事物——无论是一个微小的灵感碎片、反复推敲的思考想法，还是沉淀下来的经验与值得珍藏的内容。种子在这里种下，一切随探索自然生长。
			</p>
		</div>
		<div class="hero-actions">
			<a class="button button--red hero-btn" href="#featured">
				<span>开始探索</span>
				<ArrowDownRight size={18} strokeWidth={3} aria-hidden="true" />
			</a>
			<a class="button button--yellow hero-btn" href="#about">
				<span>了解本园</span>
			</a>
		</div>
	</div>
	<div class="hero-clipboard-deck" aria-hidden="true">
		<!-- The Main Vintage Clipboard Board -->
		<div class="clipboard-board">
			<!-- Metal Binder Clamp at Top Center -->
			<div class="binder-clamp">
				<div class="clamp-handle"></div>
				<div class="clamp-body">
					<span class="clamp-bolt"></span>
					<span class="clamp-bolt"></span>
				</div>
			</div>

			<!-- Left Side Ruler Scale -->
			<div class="clipboard-ruler">
				<span>00</span>
				<span>25</span>
				<span>50</span>
				<span>75</span>
				<span>99</span>
			</div>

			<!-- Right Side Index Tab -->
			<div class="clipboard-tab">
				<span>TAB 01 · ARTIFACTS</span>
			</div>

			<!-- Inner Board Canvas with 4 Pinned Cards -->
			<div class="clipboard-canvas">
				<!-- Card 1: 灵感 (Top-Left) -->
				<div class="collage-card collage-card--prompt">
					<span class="card-tape card-tape--yellow"></span>
					<div class="collage-card-body">
						<div class="card-title-row">
							<span class="collage-card-title">灵感</span>
							<span class="card-concept-tag">SPARKS</span>
						</div>
						<p class="card-poetic-desc">瞬间的闪光与好奇</p>
					</div>
					<span class="card-stamp card-stamp--tested">ORIGIN · 01</span>
				</div>

				<!-- Card 2: 想法 (Mid-Upper Right) -->
				<div class="collage-card collage-card--skill">
					<span class="card-pushpin"></span>
					<div class="collage-card-body">
						<div class="card-title-row">
							<span class="collage-card-title">想法</span>
							<span class="card-concept-tag">THOUGHTS</span>
						</div>
						<p class="card-poetic-desc">正在生长的雏形</p>
					</div>
					<span class="card-sub-pill">SEEDS</span>
				</div>

				<!-- Vintage Circular Rubber Stamp in Right Open Space -->
				<div class="board-circle-stamp" aria-hidden="true">
					<span class="stamp-arc">PARAPROCESS</span>
					<strong class="stamp-core">VERIFIED</strong>
					<span class="stamp-sub">ARTIFACT</span>
				</div>

				<!-- Card 3: 经验 (Mid-Lower Left) -->
				<div class="collage-card collage-card--mcp">
					<span class="card-paperclip"></span>
					<div class="collage-card-body">
						<div class="card-title-row">
							<span class="collage-card-title">经验</span>
							<span class="card-concept-tag">PRACTICE</span>
						</div>
						<p class="card-poetic-desc">真实沉淀的实践</p>
					</div>
					<span class="card-sub-pill">ROOTS</span>
				</div>

				<!-- Card 4: 收藏 (Bottom-Right) -->
				<div class="collage-card collage-card--note">
					<span class="card-folded-corner"></span>
					<div class="collage-card-body">
						<div class="card-title-row">
							<span class="collage-card-title">收藏</span>
							<span class="card-concept-tag">CURATION</span>
						</div>
						<p class="card-poetic-desc">值得驻足的美好</p>
					</div>
					<span class="card-sub-pill">BRANCHES</span>
				</div>

				<!-- Fine Registration Cross Marks -->
				<span class="board-cross-mark mark-1" aria-hidden="true">+</span>
				<span class="board-cross-mark mark-2" aria-hidden="true">+</span>
			</div>

			<!-- Bottom Board Details -->
			<div class="clipboard-footer">
				<span class="clipboard-spec-stamp">PARAPROCESS ARCHIVE · SPEC-01</span>
				<div class="clipboard-hang-tag">
					<span class="tag-body">#GARDEN-2026</span>
				</div>
			</div>
		</div>

		<!-- Background Decorative Stickers -->
		<span class="shape shape--square"></span>
		<span class="shape shape--diamond"></span>
		<span class="shape shape--star"></span>
	</div>

	<!-- Garden Harvest Receipt Strip -->
	<div class="harvest-receipt" aria-label="花园收成指标小票">
		<div class="receipt-header">
			<span class="receipt-tag">GARDEN HARVEST RECEIPT</span>
			<span class="receipt-id">#PG-2026-LIVE</span>
		</div>
		<div class="receipt-items">
			<div class="receipt-col">
				<span class="receipt-label">NO.01 SEEDS</span>
				<strong class="receipt-val receipt-val--red">RAW SPARKS</strong>
			</div>
			<div class="receipt-col">
				<span class="receipt-label">NO.02 ROOTS</span>
				<strong class="receipt-val receipt-val--teal">PRACTICE</strong>
			</div>
			<div class="receipt-col">
				<span class="receipt-label">NO.03 BRANCHES</span>
				<strong class="receipt-val receipt-val--yellow">CURATED GEMS</strong>
			</div>
			<div class="receipt-col">
				<span class="receipt-label">NO.04 SOIL</span>
				<strong class="receipt-val receipt-val--mint">DEEP THOUGHTS</strong>
			</div>
		</div>
		<div class="receipt-stamp-area" aria-hidden="true">
			<div class="receipt-barcode">
				<span></span><span></span><span></span><span></span><span></span><span></span><span></span>
			</div>
			<span class="receipt-stamp">HARVESTED</span>
		</div>
	</div>

	<!-- Washi Tape Section Divider -->
	<div class="hero-bottom-tape" aria-hidden="true"></div>
</section>
