---
import type { ExploreEntry } from '../../lib/explore-index';

interface Props {
	entries: ExploreEntry[];
}

const { entries } = Astro.props;
---

<div class="explore-fallback">
	{entries.length > 0 ? (
		<div class="explore-specimen-grid" role="list">
			{entries.map((entry, index) => {
				const itemNum = String(index + 1).padStart(2, '0');
				return (
					<a
						class={`explore-specimen-card explore-specimen-card--${entry.type}`}
						href={entry.canonicalUrl}
						role="listitem"
					>
						<div class="card-top-row">
							<span class="specimen-seq-tag">NO. {itemNum}</span>
							<span class={`mini-badge mini-badge--${entry.type}`}>
								{entry.type.toUpperCase()}
							</span>
						</div>
						<h3 class="card-title">{entry.title}</h3>
						<p class="card-summary">{entry.summary}</p>
						{entry.tags.length > 0 && (
							<div class="card-tags-list">
								{entry.tags.map((tag) => (
									<span class="specimen-pill-tag">#{tag}</span>
								))}
							</div>
						)}
						<div class="card-footer-row">
							<time datetime={entry.updatedAt} class="card-date-label">
								{entry.updatedAt}
							</time>
							<span class="specimen-direct-btn" aria-label={`直接进入 ${entry.title} 详情页`}>
								<span>进入详情</span>
								<svg class="direct-btn-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<line x1="7" y1="17" x2="17" y2="7" />
									<polyline points="7 7 17 7 17 17" />
								</svg>
							</span>
						</div>
					</a>
				);
			})}
		</div>
	) : (
		<div class="explore-empty-terminal">
			<p>暂无公开资产</p>
		</div>
	)}
</div>
