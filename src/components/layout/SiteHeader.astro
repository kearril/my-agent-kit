---
import { ArrowLeft } from '@lucide/astro';

interface Props {
	article?: boolean;
}

const { article = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--article': article }]}>
	<a class="wordmark" href={article ? '/' : '#top'}>Paracosm Garden</a>
	{article ? (
		<a class="plain-link" href="/" style="display: inline-flex; align-items: center; gap: 6px;">
			<ArrowLeft size={16} stroke-width={2.5} />
			<span>返回花园总览</span>
		</a>
	) : (
		<>
			<nav class="desktop-nav" aria-label="主要导航">
				<a href="#about">关于</a>
				<a href="#featured">精选</a>
				<a href="#updates">更新</a>
				<a href="#notes">Notes</a>
				<a href="#explore">探索</a>
			</nav>
			<details class="mobile-nav">
				<summary aria-label="打开导航">
					<span class="mobile-nav-toggle-icon" aria-hidden="true"></span>
				</summary>
				<nav aria-label="移动端主要导航">
					<a href="#about">关于</a>
					<a href="#featured">精选</a>
					<a href="#updates">更新</a>
					<a href="#notes">Notes</a>
					<a href="#explore">探索</a>
				</nav>
			</details>
		</>
	)}
</header>
