---
interface Props {
	article?: boolean;
}

const { article = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--article': article }]}>
	<a class="wordmark" href={article ? '/' : '#top'}>Paracosm Garden</a>
	{article ? (
		<a class="plain-link" href="/">← 返回花园总览</a>
	) : (
		<>
			<nav class="desktop-nav" aria-label="主要导航">
				<a href="#about">关于</a>
				<a href="#featured">精选</a>
				<a href="#updates">更新</a>
				<a href="#notes">Notes</a>
				<a href="#explore">探索</a>
			</nav>
			<details class="mobile-nav">
				<summary>菜单</summary>
				<nav aria-label="移动端主要导航">
					<a href="#about">关于</a>
					<a href="#featured">精选</a>
					<a href="#updates">更新</a>
					<a href="#notes">Notes</a>
					<a href="#explore">探索</a>
				</nav>
			</details>
		</>
	)}
</header>
