---
import { ArrowUp } from '@lucide/astro';
---

<footer class="site-footer">
	<div class="footer-rainbow" aria-hidden="true">
		<span class="rainbow-bar rainbow-bar--red"></span>
		<span class="rainbow-bar rainbow-bar--teal"></span>
		<span class="rainbow-bar rainbow-bar--yellow"></span>
		<span class="rainbow-bar rainbow-bar--mint"></span>
		<span class="rainbow-bar rainbow-bar--coral"></span>
	</div>
	<div class="footer-body">
		<div class="footer-brand">
			<a class="wordmark" href="#top">Paracosm Garden</a>
			<p class="footer-desc">
				俏皮野兽派——Neo-Brutalist 的活泼变体。<br />
				硬边缘 + 彩色 + 探索感 = 持续生长的个人数字花园。
			</p>
			<div class="footer-swatches" aria-hidden="true">
				<span class="swatch-box swatch-box--red"></span>
				<span class="swatch-box swatch-box--teal"></span>
				<span class="swatch-box swatch-box--yellow"></span>
				<span class="swatch-box swatch-box--mint"></span>
				<span class="swatch-box swatch-box--coral"></span>
			</div>
		</div>
		<div class="footer-col">
			<p class="footer-col-title">STYLE 体系</p>
			<a class="footer-link-item" href="#about">
				<span class="footer-link-bullet" style="background: var(--red);"></span>
				<span>Manifesto 原则</span>
			</a>
			<a class="footer-link-item" href="#about">
				<span class="footer-link-bullet" style="background: var(--teal);"></span>
				<span>Philosophy 理念</span>
			</a>
			<a class="footer-link-item" href="#explore">
				<span class="footer-link-bullet" style="background: var(--yellow);"></span>
				<span>Engine 引擎</span>
			</a>
		</div>
		<div class="footer-col">
			<p class="footer-col-title">GARDEN 花园</p>
			<a class="footer-link-item" href="#featured">
				<span class="footer-link-bullet" style="background: var(--yellow);"></span>
				<span>Handpicked 精选</span>
			</a>
			<a class="footer-link-item" href="#updates">
				<span class="footer-link-bullet" style="background: var(--mint);"></span>
				<span>Timeline 更新</span>
			</a>
			<a class="footer-link-item" href="#notes">
				<span class="footer-link-bullet" style="background: var(--coral);"></span>
				<span>Field Notes 笔记</span>
			</a>
		</div>
		<div class="footer-col">
			<p class="footer-col-title">PALETTE 调色盘</p>
			<span class="footer-link-item" style="cursor: default;">
				<span class="footer-link-bullet" style="background: var(--red);"></span>
				<span>Playful Red</span>
			</span>
			<span class="footer-link-item" style="cursor: default;">
				<span class="footer-link-bullet" style="background: var(--teal);"></span>
				<span>Vibrant Teal</span>
			</span>
			<span class="footer-link-item" style="cursor: default;">
				<span class="footer-link-bullet" style="background: var(--yellow);"></span>
				<span>Bold Yellow</span>
			</span>
			<span class="footer-link-item" style="cursor: default;">
				<span class="footer-link-bullet" style="background: var(--mint);"></span>
				<span>Fresh Mint</span>
			</span>
			<span class="footer-link-item" style="cursor: default;">
				<span class="footer-link-bullet" style="background: var(--coral);"></span>
				<span>Warm Coral</span>
			</span>
		</div>
	</div>
	<div class="footer-bottom-bar">
		<p class="footer-copyright">Paracosm Garden · 公开构建中 · 许可证待定</p>
		<a class="button button--yellow" href="#top">
			<span>回到顶部</span>
			<ArrowUp size={18} strokeWidth={3} aria-hidden="true" />
		</a>
	</div>
</footer>
